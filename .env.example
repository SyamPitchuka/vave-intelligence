# VAVE Intelligence — development placeholders only.
# Copy to .env and replace every secret before any shared or production use.
# Never commit the real .env file. Never put API keys in the frontend.

APP_ENV=development
APP_NAME=VAVE Intelligence
APP_VERSION=1.0.0
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# PostgreSQL with pgvector. The password below is a local development placeholder.
DATABASE_URL=postgresql+psycopg://vave:vave_dev_password@127.0.0.1:5432/vave_intelligence
TEST_DATABASE_URL=postgresql+psycopg://vave:vave_dev_password@127.0.0.1:5432/vave_intelligence_test

# Seed reference data, demo users, and the synthetic workbook on startup.
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=VaveDemo!234
ADMIN_EMAIL=admin@vave.local
ADMIN_PASSWORD=ChangeMeAdmin!23
DISPLAY_TIMEZONE=Asia/Kolkata
DATASET_LABEL=Synthetic

# AI mode: online | offline | fallback
# online  — OpenAI API, backend only
# offline — local Ollama only; outbound LLM calls are blocked
# fallback — deterministic matching; no network inference
AI_MODE=fallback
LLM_REQUIRED=false

# Online provider. Leave the key empty until the organisation approves that provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=384

# Offline provider. This application never downloads Ollama models for you.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_ALLOW_HOSTS=localhost,127.0.0.1,::1,ollama,host.docker.internal

# Embeddings. deterministic-hash-v1 is 384 dimensions and needs no model download.
# Changing the embedding model or dimension requires an explicit re-index.
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=deterministic-hash-v1
EMBEDDING_DIMENSIONS=384

RETRIEVAL_TOP_K=15
COMPARISON_TIMEOUT_SECONDS=60
FUZZY_STRONG_THRESHOLD=86
COSINE_RETRIEVE_THRESHOLD=0.22
COPILOT_LEXICAL_THRESHOLD=0.45

UPLOAD_MAX_MB=20
CHUNK_SIZE=800
CHUNK_OVERLAP=120

LOG_LEVEL=INFO
LOG_PROMPT_BODIES=false
RUN_JOBS_INLINE=false

# Optional read-only corporate source. The DSN stays in the environment, not in the database.
# CORPORATE_DATABASE_URL=postgresql+psycopg://readonly_user:password@corporate-host:5432/vave_history
CORPORATE_DATABASE_URL=
CORPORATE_IDEAS_VIEW=vave_historical_ideas

VAVE_DATA_DIR=
STORAGE_DIR=
